{
  "name": "finc",
  "version": "2.0.0",
  "private": true,
  "description": "FINC 2.0 — plataforma de gestão empresarial e emissão de documentos fiscais para MEIs e pequenas empresas",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w @finc/shared && npm run build -w @finc/api && npm run build -w @finc/web",
    "start": "npm run start -w @finc/api",
    "migrate": "npm run migrate -w @finc/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build -w @finc/shared && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "jscpd": "jscpd --config .jscpd.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run jscpd",
    "secrets:check": "bash scripts/check-secrets.sh",
    "licenses": "node scripts/licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jscpd": "5.4.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
