{
  "name": "@finc/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/migrate-cli.js",
    "admin:promover": "tsx src/scripts/promover-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@finc/shared": "2.0.0",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "node-forge": "1.4.0",
    "nodemailer": "10.1.0",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.1",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "7.0.3",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "5.0.4"
  }
}
