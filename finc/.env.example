# =====================================================================
# FINC 2.0 — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o arquivo .env com valores reais.
# =====================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# URL pública do front-end (usada em links de e-mail e CORS)
APP_URL=http://localhost:5173
# Em produção, a API serve o front-end compilado (mesma origem)
SERVE_WEB=false
# Atrás de proxy reverso (nginx, Render, etc.): "true", "loopback" ou número de saltos
TRUST_PROXY=loopback
LOG_LEVEL=info

# --- Banco de dados ---
# Desenvolvimento sem servidor: PGlite (PostgreSQL embarcado, gravado em disco)
DATABASE_URL=pglite://./.data/pglite
# Produção / Docker: PostgreSQL 13+
# DATABASE_URL=postgres://finc:troque-esta-senha@localhost:5432/finc

# --- Sessão e segurança ---
# Obrigatório em produção. Gere com: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HORAS=8
# Vazio = automático (Secure + HSTS em NODE_ENV=production). Use "false" só para testes em rede local sem HTTPS.
COOKIE_SECURE=
# Origens extras permitidas (só se o front estiver em outro domínio), separadas por vírgula
CORS_ORIGINS=

# --- Certificado digital A1 (cofre cifrado AES-256-GCM) ---
# Gere com: openssl rand -base64 32   (vazio = recurso desativado)
CERT_ENCRYPTION_KEY=

# --- E-mail (SMTP) — redefinição de senha, notificações e envio ao contador ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FINC <nao-responda@seu-dominio.com.br>"

# --- Telegram (equipe de suporte) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segredo enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# --- Consulta de CEP ---
VIACEP_URL=https://viacep.com.br/ws
POSTGRES_PASSWORD=
