# =====================================================================
#  FINC — variáveis de ambiente
#  Copie para .env (cp .env.example .env) e ajuste. NUNCA versione o .env.
#  Guia completo, variável por variável: docs/configuracao.md
#  Legenda: [obrigatória] [produção] [opcional]
# =====================================================================

# ---------------------------------------------------------------------
# 1. Servidor
# ---------------------------------------------------------------------
# Ambiente: development | test | production  [obrigatória em produção]
NODE_ENV=development
# Porta HTTP da API (e do site, quando SERVE_WEB=true)
PORT=3333
# Interface de rede. 0.0.0.0 = todas; 127.0.0.1 = só local
HOST=0.0.0.0
# URL pública pela qual os usuários acessam o site (links de e-mail e CORS). Com o site na Vercel: o domínio da Vercel. No Render sem APP_URL, usa RENDER_EXTERNAL_URL.
#   desenvolvimento: http://localhost:5173  |  produção: https://finc.seudominio.com.br
APP_URL=http://localhost:5173
# true = a API também entrega o site compilado (apps/web/dist) na mesma origem  [produção: true]
SERVE_WEB=false
# Caminho alternativo do build do site (opcional; padrão: apps/web/dist)
WEB_DIST_DIR=
# Proxy reverso à frente (nginx, Caddy, Render...): true | false | loopback | número de saltos
TRUST_PROXY=loopback
# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------
# 2. Banco de dados  [obrigatória]
# ---------------------------------------------------------------------
# Desenvolvimento sem servidor: PGlite (PostgreSQL embarcado, gravado em disco, relativo a este .env)
DATABASE_URL=pglite://./.data/pglite
# Produção: PostgreSQL 13+
# DATABASE_URL=postgres://finc:SENHA@localhost:5432/finc
# Supabase (Session pooler, porta 5432):
# DATABASE_URL=postgresql://postgres.REF_DO_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Schema das tabelas (vazio = public). No Supabase: finc (separa da versão antiga e fica fora da Data API)
DATABASE_SCHEMA=
# SSL do PostgreSQL: vazio (segue o sslmode da URL) | no-verify (Supabase) | verify | false
DATABASE_SSL=
# CA em PEM (conteúdo ou caminho do arquivo), só com DATABASE_SSL=verify
DATABASE_SSL_CA=
# Diretório alternativo das migrações SQL (opcional; padrão: db/migrations)
MIGRATIONS_DIR=

# ---------------------------------------------------------------------
# 3. Sessão e segurança
# ---------------------------------------------------------------------
# Segredo de assinatura (CSRF). Gere: openssl rand -base64 48   [obrigatória em produção, mín. 32 caracteres]
SESSION_SECRET=
# Duração da sessão em horas (1 a 720)
SESSION_TTL_HORAS=8
# Cookies "Secure" + HSTS. Vazio = automático (ligado em produção).
# Use "false" SOMENTE para testar em rede local sem HTTPS.
COOKIE_SECURE=
# Origens extras permitidas, separadas por vírgula (só se o site estiver em outro subdomínio do mesmo site)
CORS_ORIGINS=
# Desliga o limite de requisições (somente testes automatizados; proibido em produção)
RATE_LIMIT_DESATIVADO=false

# ---------------------------------------------------------------------
# 4. Certificado digital A1 (cofre cifrado AES-256-GCM)  [opcional]
# ---------------------------------------------------------------------
# 32 bytes em base64. Gere: openssl rand -base64 32. Vazio = envio de certificado desativado.
# ATENÇÃO: guarde esta chave; sem ela os certificados salvos não podem ser lidos.
CERT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# 5. E-mail (SMTP) — redefinição de senha, notificações e envio ao contador  [opcional]
# ---------------------------------------------------------------------
SMTP_HOST=
# 587 (STARTTLS, SMTP_SECURE=false) ou 465 (TLS direto, SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FINC <nao-responda@seu-dominio.com.br>"

# ---------------------------------------------------------------------
# 6. Telegram — avisos da equipe de suporte  [opcional]
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segredo do webhook (header X-Telegram-Bot-Api-Secret-Token). Gere: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# 7. Consulta de CEP  [opcional]
# ---------------------------------------------------------------------
VIACEP_URL=https://viacep.com.br/ws

# ---------------------------------------------------------------------
# 8. Docker Compose (lidas apenas pelo docker-compose.yml)
# ---------------------------------------------------------------------
# Senha do PostgreSQL do container. Gere: openssl rand -hex 16  [obrigatória no Docker]
POSTGRES_PASSWORD=
# Porta publicada no host
FINC_PORT=3333

# ---------------------------------------------------------------------
# 9. Front-end (Vite) — definir em apps/web/.env.local ou no ambiente do build
# ---------------------------------------------------------------------
# VITE_API_URL=          # URL da API quando o site é hospedado em outro endereço (vazio = mesma origem)
# VITE_API_PROXY=        # destino do proxy /api no "npm run dev" (padrão: http://localhost:3333)

# ---------------------------------------------------------------------
# 10. Testes (definir só ao executar os testes)
# ---------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres   # roda a suíte da API em PostgreSQL real
# E2E_BASE_URL=http://127.0.0.1:3333                               # roda o Playwright contra uma instância existente
# E2E_PORT=3399                                                    # porta da instância criada pelo Playwright
